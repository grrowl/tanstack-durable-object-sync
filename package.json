{
  "name": "tanstack-durable-object-sync",
  "version": "0.6.0",
  "description": "Sync a TanStack DB collection to a Cloudflare Durable Object over WebSockets — optimistic mutations, live queries, and single-ordered-stream write confirmation.",
  "type": "module",
  "license": "MIT",
  "author": "Tom McKenzie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grrowl/tanstack-durable-object-sync.git"
  },
  "homepage": "https://github.com/grrowl/tanstack-durable-object-sync#readme",
  "bugs": {
    "url": "https://github.com/grrowl/tanstack-durable-object-sync/issues"
  },
  "keywords": [
    "tanstack-db",
    "cloudflare",
    "durable-objects",
    "sync",
    "local-first",
    "websocket",
    "optimistic",
    "live-query"
  ],
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server/mixin": {
      "types": "./dist/server/mixin.d.ts",
      "import": "./dist/server/mixin.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0"
  },
  "peerDependencies": {
    "@tanstack/db": ">=0.8.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.7",
    "@cloudflare/workers-types": "^4.20260518.1",
    "@tanstack/db": "^0.9.2",
    "typescript": "^5.7",
    "vitest": "4.1.10",
    "wrangler": "^4"
  }
}
