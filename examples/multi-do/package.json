{
  "name": "tanstack-do-db-multi-do-example",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/client.tsx --bundle --outfile=public/client.js --format=esm --jsx=automatic --alias:@tanstack/db=@tanstack/db",
    "watch:client": "esbuild src/client.tsx --bundle --outfile=public/client.js --format=esm --jsx=automatic --alias:@tanstack/db=@tanstack/db --watch",
    "build": "rm -rf dist && npm run build:client -- --metafile=dist/client.meta.json && wrangler deploy --dry-run --outdir dist/worker --metafile",
    "typecheck": "tsc --noEmit",
    "check:single-copy": "node ../check-single-copy.mjs . dist/client.meta.json dist/worker/bundle-meta.json",
    "dev": "npm run build:client && wrangler dev",
    "smoke": "node ../smoke-boot.mjs 8787 \"wrangler dev --port 8787 --ip 127.0.0.1\" \"GET / >>client.js\" \"WS /rooms/smoke/sync?user=smoke\" \"WS /inbox/smoke/sync?user=smoke\""
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "@tanstack/db": "0.9.2",
    "@tanstack/react-db": "0.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260518.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "esbuild": "^0.24.0",
    "typescript": "^5.7",
    "wrangler": "^4"
  }
}
