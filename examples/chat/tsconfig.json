{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    // Type the adapter's ../../src against this example's @tanstack/db, not the root's.
    "paths": { "@tanstack/db": ["./node_modules/@tanstack/db"] }
  },
  "include": ["src/**/*"]
}
