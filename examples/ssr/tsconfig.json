{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "vite/client"],
    // The file: dependency's .d.ts files import `@tanstack/db` from the REPO
    // ROOT's node_modules; type them against this example's copy (ADR-0024).
    "paths": { "@tanstack/db": ["./node_modules/@tanstack/db"] }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
